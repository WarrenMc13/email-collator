# Copy this file to .env and fill in your details.
# The tool will prompt for any missing values at runtime.

# IMAP server — common examples:
#   Gmail:        imap.gmail.com   (requires an App Password if 2FA is on)
#   Outlook/365:  outlook.office365.com
#   Yahoo:        imap.mail.yahoo.com
#   Generic host: imap.yourdomain.com
IMAP_HOST=imap.gmail.com

# Port: 993 for SSL (recommended), 143 for STARTTLS
IMAP_PORT=993

# Your full email address
IMAP_USERNAME=your.email@gmail.com

# Your password or App Password
# Gmail users: generate one at https://myaccount.google.com/apppasswords
IMAP_PASSWORD=your_app_password_here
